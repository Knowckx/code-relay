{
  "name": "code-relay",
  "displayName": "Code Relay",
  "description": "Send the right code context to AI",
  "version": "0.0.1",
  "publisher": "knowckx",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Knowckx/code-relay.git"
  },
  "bugs": {
    "url": "https://github.com/Knowckx/code-relay/issues"
  },
  "homepage": "https://github.com/Knowckx/code-relay#readme",
  "keywords": [
    "ai",
    "code-context",
    "clipboard",
    "file-path",
    "line-number"
  ],
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-relay.copyPathAndLine",
        "title": "Copy Path and Line",
        "category": "CodeRelay"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "code-relay.copyPathAndLine",
          "when": "editorTextFocus"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "code-relay.copyPathAndLine",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "1.136.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
